            "body": { "mode": "raw", "raw": "{\n  \"name\": \"reservations.view_all\",\n  \"resource\": \"reservations\",\n  \"action\": \"view_all\",\n  \"is_active\": true\n}" },
            "url": { "raw": "{{roles_base}}/permissions", "host": ["{{roles_base}}"], "path": ["permissions"] }
          },
          "response": []
