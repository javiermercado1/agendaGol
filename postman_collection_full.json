            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cancha 1\",\n  \"location\": \"Ciudad\",\n  \"capacity\": 10,\n  \"price_per_hour\": 20.0,\n  \"opening_time\": \"10:00\",\n  \"closing_time\": \"22:00\",\n  \"description\": \"Buena cancha\",\n  \"is_active\": true\n}" },
            "url": { "raw": "{{fields_base}}/fields/", "host": ["{{fields_base}}"], "path": ["fields",""] }
          },
          "response": []
        },
        {
          "name": "List fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{fields_base}}/fields?skip=0&limit=10", "host": ["{{fields_base}}"], "path": ["fields"] }
          },
          "response": []
        },
        {
          "name": "Get field by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{fields_base}}/fields/1", "host": ["{{fields_base}}"], "path": ["fields","1"] }
          },
          "response": []
        },
        {
          "name": "Update field (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price_per_hour\": 25.0\n}" },
            "url": { "raw": "{{fields_base}}/fields/1", "host": ["{{fields_base}}"], "path": ["fields","1"] }
          },
          "response": []
        },
        {
          "name": "Delete field (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{fields_base}}/fields/1", "host": ["{{fields_base}}"], "path": ["fields","1"] }
          },
          "response": []
        },
        {
          "name": "Field availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{fields_base}}/fields/1/availability?date=2026-01-20", "host": ["{{fields_base}}"], "path": ["fields","1","availability"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Roles Service",
      "item": [
