{
  "info": {
    "name": "AgendaGol - Full Local",
    "_postman_id": "agendagol-full-local",
    "description": "Colección completa para probar todos los endpoints locales de AgendaGol",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auth_base", "value": "http://localhost:8000" },
    { "key": "roles_base", "value": "http://localhost:8001" },
    { "key": "fields_base", "value": "http://localhost:8002" },
    { "key": "reservations_base", "value": "http://localhost:8003" },
    { "key": "dashboard_base", "value": "http://localhost:8004" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{auth_base}}/auth/register", "host": ["{{auth_base}}"], "path": ["auth","register"] }
          },
          "response": []
        },
        {
          "name": "Login (get token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{auth_base}}/auth/login", "host": ["{{auth_base}}"], "path": ["auth","login"] }
          },
          "response": []
        },
        {
          "name": "Verify token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{auth_base}}/auth/verify", "host": ["{{auth_base}}"], "path": ["auth","verify"] }
          },
          "response": []
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{auth_base}}/auth/me", "host": ["{{auth_base}}"], "path": ["auth","me"] }
          },
          "response": []
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"nuevoNombre\"\n}" },
            "url": { "raw": "{{auth_base}}/auth/profile", "host": ["{{auth_base}}"], "path": ["auth","profile"] }
          },
          "response": []
        },
        {
          "name": "Password recovery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\"\n}" },
            "url": { "raw": "{{auth_base}}/auth/password-recovery", "host": ["{{auth_base}}"], "path": ["auth","password-recovery"] }
          },
          "response": []
        },
        {
          "name": "Register admin (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"adminuser\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"adminpass\"\n}" },
            "url": { "raw": "{{auth_base}}/auth/register-admin", "host": ["{{auth_base}}"], "path": ["auth","register-admin"] }
          },
          "response": []
        },
        {
          "name": "Get all users (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{auth_base}}/auth/users?skip=0&limit=20", "host": ["{{auth_base}}"], "path": ["auth","users"] }
          },
          "response": []
        },
        {
          "name": "Get users stats (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{auth_base}}/auth/users/stats", "host": ["{{auth_base}}"], "path": ["auth","users","stats"] }
          },
          "response": []
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{auth_base}}/auth/user/1", "host": ["{{auth_base}}"], "path": ["auth","user","1"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reservations Service",
      "item": [
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"field_id\": 1,\n  \"start_time\": \"2026-01-20T14:00:00\",\n  \"duration_hours\": 1,\n  \"notes\": \"Prueba desde Postman\"\n}" },
            "url": { "raw": "{{reservations_base}}/reservations/", "host": ["{{reservations_base}}"], "path": ["reservations",""] }
          },
          "response": []
        },
        {
          "name": "List reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{reservations_base}}/reservations?skip=0&limit=10", "host": ["{{reservations_base}}"], "path": ["reservations"] }
          },
          "response": []
        },
        {
          "name": "My reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{reservations_base}}/reservations/my?skip=0&limit=10", "host": ["{{reservations_base}}"], "path": ["reservations","my"] }
          },
          "response": []
        },
        {
          "name": "Get reservation by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{reservations_base}}/reservations/123", "host": ["{{reservations_base}}"], "path": ["reservations","123"] }
          },
          "response": []
        },
        {
          "name": "Update reservation",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"start_time\": \"2026-01-20T15:00:00\",\n  \"duration_hours\": 2\n}" },
            "url": { "raw": "{{reservations_base}}/reservations/123", "host": ["{{reservations_base}}"], "path": ["reservations","123"] }
          },
          "response": []
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"No puedo asistir\"\n}" },
            "url": { "raw": "{{reservations_base}}/reservations/123/cancel", "host": ["{{reservations_base}}"], "path": ["reservations","123","cancel"] }
          },
          "response": []
        },
        {
          "name": "Reservations stats (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{reservations_base}}/reservations/stats", "host": ["{{reservations_base}}"], "path": ["reservations","stats"] }
          },
          "response": []
        },
        {
          "name": "Field reservations by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{reservations_base}}/reservations/field/1/date/2026-01-20", "host": ["{{reservations_base}}"], "path": ["reservations","field","1","date","2026-01-20"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fields Service",
      "item": [
        {
          "name": "Create field (admin)",
          "request": {
            "method": "POST",
