            "body": { "mode": "raw", "raw": "{\n  \"name\": \"editor\",\n  \"description\": \"Editor role\",\n  \"is_active\": true\n}" },
            "url": { "raw": "{{roles_base}}/roles", "host": ["{{roles_base}}"], "path": ["roles"] }
          },
          "response": []
